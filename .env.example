# ── Anthropic / Claude ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── News API ───────────────────────────────────────────────────────────────────
# Get a free key at https://newsapi.org/register
# Note: free tier only returns articles from the past 30 days.
# For the SVB retrospective demo, mock_news_svb.json is used as a fallback.
NEWSAPI_KEY=your_newsapi_key_here

# ── SEC EDGAR ──────────────────────────────────────────────────────────────────
# No API key required. SEC requests an org name + email for User-Agent header.
SEC_USER_AGENT_ORG=YourOrganization
SEC_USER_AGENT_EMAIL=your@email.com

# ── Paths (override defaults from config.py if needed) ─────────────────────────
# DATA_DIR=./data
# CHROMA_DIR=./data/chroma
# FILINGS_DIR=./data/filings
# AUDIT_DB_PATH=./data/audit.db
